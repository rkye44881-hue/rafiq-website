rules_version = '2';
// Paste this into Firebase console → Firestore Database → Rules, then press Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // An admin is any account with a document in the "admins" collection (added by hand in the console)
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function onlyChanges(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Each driver may only send their own location
    match /drivers/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && onlyChanges(['lat', 'lng', 'speed', 'heading', 'accuracy', 'battery', 'online', 'updatedAt']));
    }

    // A driver may only write the odometer reading of the car given to them
    match /cars/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
      allow update: if signedIn()
        && get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.carId == id
        && onlyChanges(['odometer', 'odometerAt', 'odometerBy']);
    }

    // One document per shift: odometer at the start, start and end time
    match /shifts/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.driverId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.driverId == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.driverId == request.auth.uid && onlyChanges(['endAt', 'endKm']));
      allow delete: if isAdmin();
    }

    // Kilometres per driver per day, named <driverId>_<date>
    match /kmDaily/{id} {
      allow read: if isAdmin();
      allow create, update: if signedIn() && id.matches(request.auth.uid + '_.*')
        && request.resource.data.driverId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // A driver sees only the jobs given to them and may only move the status forward
    match /jobs/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.driverId == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && resource.data.driverId == request.auth.uid
        && request.resource.data.status in ['accepted', 'onway', 'arrived', 'done']
        && onlyChanges(['status', 'updatedAt', 'acceptedAt', 'onwayAt', 'arrivedAt', 'doneAt']));
    }

    // Route history: one document per driver per day, named <driverId>_<date>
    match /tracks/{id} {
      allow read: if isAdmin();
      allow create, update: if signedIn() && id.matches(request.auth.uid + '_.*')
        && request.resource.data.driverId == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
