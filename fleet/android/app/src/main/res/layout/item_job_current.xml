<?xml version="1.0" encoding="utf-8"?>
<!-- The job the driver is on now: big, coloured, clear buttons -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/current_job_bg"
    android:elevation="4dp"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_white"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:textColor="@color/brand"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView android:id="@+id/time" style="@style/JobLine.Light" />
    <TextView android:id="@+id/pickup" style="@style/JobLine.Light" />
    <TextView android:id="@+id/dropoff" style="@style/JobLine.Light" />
    <TextView android:id="@+id/customer" style="@style/JobLine.Light" />
    <TextView android:id="@+id/notes" style="@style/JobLine.Light" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="@color/white"
        android:textColor="@color/brand"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/call"
            style="@style/JobButton.Light"
            android:layout_marginEnd="8dp"
            android:text="@string/call" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/whatsapp"
            style="@style/JobButton.Light"
            android:text="@string/whatsapp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_pickup"
            style="@style/JobButton.Light"
            android:layout_marginEnd="8dp"
            android:text="@string/nav_pickup" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_dropoff"
            style="@style/JobButton.Light"
            android:text="@string/nav_dropoff" />
    </LinearLayout>
</LinearLayout>
