<?xml version="1.0" encoding="utf-8"?>
<!-- A job waiting after the current one -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView android:id="@+id/time" style="@style/JobLine" />
    <TextView android:id="@+id/pickup" style="@style/JobLine" />
    <TextView android:id="@+id/dropoff" style="@style/JobLine" />
    <TextView android:id="@+id/customer" style="@style/JobLine" />
    <TextView android:id="@+id/notes" style="@style/JobLine" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/call"
            style="@style/JobButton"
            android:layout_marginEnd="6dp"
            android:text="@string/call" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/whatsapp"
            style="@style/JobButton"
            android:layout_marginEnd="6dp"
            android:text="@string/whatsapp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_pickup"
            style="@style/JobButton"
            android:text="@string/nav_pickup" />
    </LinearLayout>

    <!-- Kept for the shared binding code; the map to the drop-off is on the current job -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/nav_dropoff"
        style="@style/JobButton"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:textSize="16sp" />
</LinearLayout>
